{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/daily-knowledge-plan.schema.json",
  "title": "DailyKnowledgePlan",
  "description": "每日学习计划：只读建议，不创建 LearningState 或 LearningEvidence。保存在 .runtime/，可随时重建。",
  "type": "object",
  "required": ["id", "localDate", "generatedAt", "vaultFingerprint", "goalRefs", "capacity", "allocation", "items"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "ownerId": { "type": "string" },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "vaultFingerprint": { "type": "string" },
    "goalRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capacity": { "type": "integer", "minimum": 1, "maximum": 20 },
    "allocation": {
      "type": "object",
      "required": ["digest", "ingest", "maintenance"],
      "properties": {
        "digest": { "type": "integer", "minimum": 0 },
        "ingest": { "type": "integer", "minimum": 0 },
        "maintenance": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "reason", "priority", "area", "intent", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["review", "digest", "ingest", "maintenance", "output", "goal"] },
          "title": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
          "area": { "enum": ["learn", "capture", "knowledge", "create", "today", "approvals"] },
          "intent": { "type": "string", "minLength": 1 },
          "ref": { "type": "string" },
          "status": { "enum": ["pending", "in_progress", "completed", "skipped"] },
          "dueAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
