{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/inbox-candidate.schema.json",
  "title": "InboxCandidate",
  "type": "object",
  "required": ["id", "artifactId", "title", "status", "confidence", "created"],
  "properties": {
    "id": { "type": "string" },
    "artifactId": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "status": { "enum": ["pending", "proposed", "accepted", "rejected", "failed"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "dedupeMatches": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "created": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
