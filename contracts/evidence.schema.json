{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": ["id", "sourceRef", "sourceTier", "stance", "status", "observedAt"],
  "properties": {
    "id": { "type": "string" },
    "sourceRef": { "type": "string", "minLength": 1 },
    "sourceTier": { "enum": ["first-party", "primary", "secondary", "community", "personal"] },
    "stance": { "enum": ["supports", "contradicts", "limits", "context"] },
    "status": { "enum": ["candidate", "verified", "rejected", "superseded"] },
    "excerpt": { "type": "string" },
    "observedAt": { "type": "string", "format": "date-time" },
    "verifiedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
