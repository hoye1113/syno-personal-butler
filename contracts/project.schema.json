{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/project.schema.json",
  "title": "Project",
  "type": "object",
  "required": ["projectRef", "ownerKey", "title", "status", "objective", "doneCondition", "createdAt", "updatedAt"],
  "properties": {
    "projectRef": { "type": "string", "pattern": "^project-\\d{8}-[a-f0-9]{8}$" },
    "ownerKey": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "paused", "completed", "abandoned"] },
    "objective": { "type": "string", "minLength": 1 },
    "doneCondition": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
