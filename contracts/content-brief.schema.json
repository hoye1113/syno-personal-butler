{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/content-brief.schema.json",
  "title": "ContentBrief",
  "type": "object",
  "required": ["id", "ideaId", "audience", "outline", "status"],
  "properties": {
    "id": { "type": "string" },
    "ideaId": { "type": "string" },
    "audience": { "type": "string" },
    "outline": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "status": { "enum": ["draft", "approved", "scheduled", "archived"] }
  }
}
