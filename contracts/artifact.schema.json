{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/artifact.schema.json",
  "title": "Artifact",
  "type": "object",
  "required": ["id", "kind", "path", "created", "isolated"],
  "properties": {
    "id": { "type": "string" },
    "kind": { "enum": ["url", "text", "markdown", "pdf", "image", "file", "bilibili-opus"] },
    "path": { "type": "string" },
    "created": { "type": "string", "format": "date-time" },
    "isolated": { "type": "boolean" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "size": { "type": "integer", "minimum": 0, "maximum": 10485760 },
    "mime": { "type": "string" }
  },
  "additionalProperties": true
}
