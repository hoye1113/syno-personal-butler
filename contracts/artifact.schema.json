{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/artifact.schema.json",
  "title": "Artifact",
  "type": "object",
  "required": ["id", "kind", "path", "created", "isolated", "sourceDescriptor"],
  "properties": {
    "id": { "type": "string" },
    "kind": { "enum": ["url", "wechat", "text", "markdown", "txt", "pdf", "docx", "html", "personal", "image", "voice", "file", "bilibili-opus", "github-doc"] },
    "path": { "type": "string" },
    "created": { "type": "string", "format": "date-time" },
    "isolated": { "type": "boolean" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "sourceDescriptor": { "$ref": "source-descriptor.schema.json" },
    "size": { "type": "integer", "minimum": 0, "maximum": 10485760 },
    "mime": { "type": "string" },
    "status": { "enum": ["received", "quarantined", "extracted", "proposed", "accepted", "rejected", "failed"] },
    "dedupeKey": { "type": "string" },
    "ownerId": { "type": "string" }
  },
  "additionalProperties": true
}
