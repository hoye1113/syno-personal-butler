{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/content-idea.schema.json",
  "title": "ContentIdea",
  "type": "object",
  "required": ["type", "topic_id", "title", "status", "stage"],
  "properties": {
    "type": { "enum": ["选题策划"] },
    "topic_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "claim": { "type": "string" },
    "status": { "enum": ["active", "rejected", "archived"] },
    "stage": { "type": "string", "minLength": 1 },
    "source_wiki_pages": { "type": "array", "items": { "type": "string" } },
    "source_inbox_path": { "type": "string" },
    "source_url": { "type": "string" }
  },
  "additionalProperties": true
}
