{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/inspiration.schema.json",
  "title": "Inspiration",
  "type": "object",
  "required": ["id", "date", "sampledRefs", "text", "status", "created"],
  "properties": {
    "id": { "type": "string", "pattern": "^inspiration-\\d{8}-[a-f0-9]{8}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sampledRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "minItems": 2 },
    "text": { "type": "string", "minLength": 1 },
    "status": { "enum": ["generated", "delivered", "feedback"] },
    "attempts": { "type": "integer", "minimum": 0 },
    "deliveryEventId": { "type": "string" },
    "deliveredAt": { "type": "string", "format": "date-time" },
    "deliveredOwnerKey": { "type": "string" },
    "deliveredChannel": { "type": "string" },
    "deliveredThreadKey": { "type": "string" },
    "feedback": { "enum": ["useful", "neutral", "not_useful"] },
    "feedbackAt": { "type": "string", "format": "date-time" },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
