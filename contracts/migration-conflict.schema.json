{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/migration-conflict.schema.json",
  "title": "MigrationConflict",
  "type": "object",
  "required": ["sourcePath", "targetPath", "sourceSha256", "targetSha256", "decision"],
  "properties": {
    "sourcePath": { "type": "string", "minLength": 1 },
    "targetPath": { "type": "string", "pattern": "^vault/" },
    "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision": { "const": "keep-syno" },
    "summary": { "type": "string" }
  },
  "additionalProperties": false
}
