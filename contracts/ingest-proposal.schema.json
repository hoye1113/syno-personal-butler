{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/ingest-proposal.schema.json",
  "title": "IngestProposal",
  "type": "object",
  "required": [
    "id", "candidateId", "status", "suggestedPath", "suggestedTags", "suggestedLinks",
    "sourceDescriptor", "sourceType", "quality", "materialTier", "canonicalTags",
    "duplicateAssessment", "relations", "mocChanges", "claimCandidates",
    "evidenceCandidates", "unresolved", "validators", "risk", "sourceDigest",
    "proposalDigest", "created"
  ],
  "properties": {
    "id": { "type": "string" },
    "candidateId": { "type": "string" },
    "status": { "enum": ["proposed", "approved", "rejected", "applied", "failed"] },
    "suggestedPath": { "type": "string", "pattern": "^vault/(00-Inbox|01-Areas|02-Resources|03-Archive)/" },
    "suggestedTags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "suggestedLinks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "splitTitles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "existingNoteRef": { "type": "string" },
    "previousProposalId": { "type": "string" },
    "revisionRequest": { "type": "string", "minLength": 1 },
    "sourceDescriptor": { "$ref": "source-descriptor.schema.json" },
    "sourceType": { "type": "string" },
    "sourceProfile": {
      "type": "object",
      "properties": {
        "ingestWorkflow": { "const": "bilibili_opus_ingest_v2" },
        "primarySource": { "const": "column" },
        "opusId": { "type": "string" },
        "columnId": { "type": "string" },
        "bv": { "type": "string" },
        "videoUrl": { "type": "string" },
        "uploader": { "type": "string" },
        "sourceTier": { "enum": ["C1", "C2"] },
        "sourceForm": { "enum": ["lecture", "dialogue", "roundtable"] },
        "contentForm": { "enum": ["lecture", "dialogue", "roundtable"] },
        "dialogueFidelity": { "enum": ["source", "reconstructed", "none"] },
        "questionSource": { "enum": ["column", "editorial", "none"] },
        "voiceBasis": { "enum": ["direct_speech", "attributed_paraphrase", "editorial_summary", "mixed"] },
        "factualStatus": { "enum": ["verified", "partial", "unverified"] },
        "factualReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "verificationScope": { "enum": ["column_only", "column_plus_original"] },
        "verificationBasis": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "canonicalBody": { "type": "string", "minLength": 1 },
    "sourceReport": {
      "type": "object",
      "required": ["workflow", "sourceId", "route", "targetPath", "sourcesRead", "sourcesSkipped", "retention", "relatedNotes", "conceptCandidates", "mocUpdates", "checks", "unresolved", "status"],
      "properties": {
        "workflow": { "const": "bilibili_opus_ingest_v2" },
        "sourceId": { "type": "object" },
        "route": { "type": "object" },
        "targetPath": { "type": "string" },
        "sourcesRead": { "type": "array", "items": { "type": "string" } },
        "sourcesSkipped": { "type": "array", "items": { "type": "string" } },
        "retention": { "type": "object" },
        "relatedNotes": { "type": "array", "items": { "type": "string" } },
        "conceptCandidates": { "type": "array", "items": { "type": "string" } },
        "mocUpdates": { "type": "array", "items": { "type": "object" } },
        "checks": { "type": "object" },
        "unresolved": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["complete", "incomplete", "rejected"] }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": { "enum": ["pending", "accepted", "limited", "rejected"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "materialTier": { "enum": ["S", "A", "B", "unrated"] },
    "canonicalTags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "duplicateAssessment": {
      "type": "object",
      "required": ["matches", "sameSource", "updateStatus"],
      "properties": {
        "matches": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "sameSource": { "type": "boolean" },
        "updateStatus": { "enum": ["new", "same", "changed", "unknown"] }
      },
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target", "reason"],
        "properties": {
          "type": { "enum": ["supports", "extends", "contradicts", "limits", "depends_on", "applies_to", "example_of"] },
          "target": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "mocChanges": { "type": "array", "items": { "type": "object" } },
    "claimCandidates": { "type": "array", "items": { "type": "object" } },
    "evidenceCandidates": { "type": "array", "items": { "type": "object" } },
    "unresolved": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "validators": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rulesDigest": { "type": "string" },
    "sourceDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "proposalDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "risk": { "enum": ["additive", "overwrite", "merge", "new-tag", "new-moc", "high"] },
    "created": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
