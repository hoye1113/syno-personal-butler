{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syno.local/contracts/job.schema.json",
  "title": "Job",
  "type": "object",
  "required": ["id", "intent", "status", "profile", "approval", "created", "updated", "request"],
  "properties": {
    "id": { "type": "string", "pattern": "^job-[a-z0-9-]+$" },
    "intent": { "type": "string" },
    "status": { "enum": ["pending", "awaiting_approval", "running", "waiting_provider", "validating", "completed", "failed", "rejected", "canceled"] },
    "profile": { "enum": ["syno-read", "syno-ops", "syno-curate", "syno-code"] },
    "approval": { "enum": ["none", "single", "double"], "description": "trust-but-clarify：运行期恒为 none（默认自动执行）。single/double 仅保留以兼容历史 Job 记录，不再由 Policy 产生。" },
    "approvalsReceived": { "type": "integer", "minimum": 0, "maximum": 2, "description": "历史字段；trust-but-clarify 下不再用于审批计数，保留兼容旧记录。" },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "request": { "type": "object" },
    "changedPaths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "advice": { "type": "object", "description": "收录澄清顾问懒加载生成的说明（可选缓存；仅用于系统歧义澄清卡片；含 whatIsIt/recommendation/recommendationLabel/reason/caveat/detail/via/generatedAt）" },
    "ownerKey": { "type": "string" },
    "threadKey": { "type": "string" }
  },
  "additionalProperties": true
}

