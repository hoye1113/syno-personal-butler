# Syno 运行时密钥示例。复制为 .env 并填写（.env 已被 .gitignore 忽略，不会入库）。
# Kimi Code API Key：https://www.kimi.com/code/console 创建（仅创建时显示一次）。
KIMI_API_KEY=

# 搜索 provider keys（免费档；未填写的 provider 会被自动跳过）
# 豆包搜索（火山引擎，500 次/月免费）：https://console.volcengine.com/search-infinity/api-key
DOUBAO_SEARCH_API_KEY=
# Tavily（1000 credit/月，无需绑卡）：https://app.tavily.com
TAVILY_API_KEY=
# Exa（每月 $10 免费额度，无需绑卡）：https://dashboard.exa.ai/api-keys
EXA_API_KEY=
